# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略，不会提交到仓库。

# ===== 必填：LLM / 搜索 / 重排 API Key（不填则对应能力不可用）=====
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
TAVILY_API_KEY=
RERANK_API_KEY=

# ===== 中间件连接（宿主机上的 7 个服务，容器内统一用 host.docker.internal 访问）=====
SPRING_DATASOURCE_URL="jdbc:mysql://host.docker.internal:3306/nexus_agent?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false"
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me

SPRING_DATA_REDIS_HOST=host.docker.internal
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=change-me

SPRING_KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9092

NEXUS_AGENT_MINIO_ENDPOINT=http://host.docker.internal:9000
NEXUS_AGENT_MINIO_ACCESS_KEY=minio
NEXUS_AGENT_MINIO_SECRET_KEY=change-me

NEXUS_AGENT_PGVECTOR_HOST=host.docker.internal
NEXUS_AGENT_PGVECTOR_PORT=5432
NEXUS_AGENT_PGVECTOR_DATABASE=nexus_agent_pgvector
NEXUS_AGENT_PGVECTOR_USERNAME=postgres
NEXUS_AGENT_PGVECTOR_PASSWORD=change-me

NEXUS_AGENT_ES_URIS=http://host.docker.internal:9200
NEXUS_AGENT_ES_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me

NEXUS_AGENT_NEO4J_URI=bolt://host.docker.internal:7687
NEXUS_AGENT_NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# ===== 后台管理账号（生产环境建议修改）=====
NEXUS_AGENT_ADMIN_USERNAME=admin
NEXUS_AGENT_ADMIN_PASSWORD=change-me
NEXUS_AGENT_ADMIN_TOKEN_SECRET=change-me
